# === App environment settings ===
SECRET_KEY=your_secret_key_here
ENVIRONMENT=DEV  # or PROD

ACCESS_TOKEN_EXPIRE_MINUTES=11520
REFRESH_TOKEN_EXPIRE_MINUTES=40320

BACKEND_CORS_ORIGINS=["http://localhost:8000", "http://localhost:5173"]
ALLOWED_HOSTS=["localhost", "127.0.0.1", "http://localhost:5173/"]

# === Default (production) database ===
DEFAULT_DATABASE_HOSTNAME=localhost
DEFAULT_DATABASE_USER=your_postgres_user
DEFAULT_DATABASE_PASSWORD=your_postgres_password
DEFAULT_DATABASE_PORT=5433
DEFAULT_DATABASE_DB=app

# === Test database ===
TEST_DATABASE_HOSTNAME=localhost
TEST_DATABASE_USER=your_postgres_user
TEST_DATABASE_PASSWORD=your_postgres_password
TEST_DATABASE_PORT=5434
TEST_DATABASE_DB=watch-test

# === Initial superuser credentials ===
FIRST_SUPERUSER_EMAIL=your@email.com
FIRST_SUPERUSER_PASSWORD=your_password

# === External API keys (optional) ===
OPENAI_API_KEY=your_openai_key
OPENAI_ORGANIZATION=your_openai_org_id

GEMINI_API_KEY=your_gemini_api_key
